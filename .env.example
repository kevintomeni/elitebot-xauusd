# ============================================================================
#  EliteBot XAUUSD — Modèle de variables d'environnement
#  Copiez ce fichier en .env pour l'utilisation locale (Docker, Render, Railway)
#  et complétez les valeurs. Les secrets ne doivent JAMAIS être versionnés.
# ============================================================================
#
#  📘 UTILISATION DU COMPTE MT5 (mode LIVE uniquement)
#  -------------------------------------------------------------------------
#  1. Ouvrez votre compte METATRADER 5 (DEMO d'abord recommandé).
#  2. Ouvrez le terminal MT5 (appliqué à votre serveur) :
#       Menu : Window → Terminal (ou Ctrl+M)
#       Connectez-vous au serveur indiqué dans le champ "Server".
#  3. Récupérez les infos dans le terminal :
#       - Login : numéro du compte (ex: 12345678)
#       - Password : le mot de passe du compte
#       - Server : nom du serveur (ex: Weltrade-Demo)
#  4. Dans ce fichier, renseignez :
#       MT5_LOGIN=12345678
#       MT5_PASSWORD=votre_mot_de_passe
#       MT5_SERVER=Weltrade-Demo
#       MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal.exe
#  5. Démarrez le bot en mode live :
#       MODE=live
#  6. Vérifiez sur le dashboard : "Broker connecté" et "Prix XAUUSD".
#  7. Cliquez sur "Robot ON" pour démarrer le trading.
#
#  📘 MODE SIMULATION (recommandé pour valider le système)
#  -------------------------------------------------------------------------
#  Pour valider le bot sans risque, laissez les identifiants vides.
#  Le bot bascule automatiquement en "SIMULATION" (paper trading).
#  Le dashboard affichera "SIMULATION" et vous pouvez tester toutes les
#  fonctions (Paires, P/L, ordres, filtres, circuit-breaker) sans risque.
#
#  🚨 SÉCURITÉ
#  -------------------------------------------------------------------------
#  • Aucun identifiant n'est stocké dans le code ou le dépôt
#  • .env et config.json sont ignorés par git
#  • Le bot est désactivé si MODE=live et identifiants manquants
#  • Le circuit-breaker bloque jusqu'à minuit si drawdown ≥ 3 %
#  • Le PANIC BUTTON liquide toutes les positions et désactive le robot
# ============================================================================

# ── Compte MT5 (mode LIVE) ─────────────────────────────────────────────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# ── Mode d'exécution : auto | live | sim ────────────────────────────────────
# auto  : MT5 si le terminal est démarré, sinon simulation
# live  : connexion réelle au compte (exige les identifiants ci-dessus)
# sim   : simulation uniquement (paper trading, sans risque)
MODE=auto

# ── Instrument & moteur ─────────────────────────────────────────────────────
SYMBOL=XAUUSD
MAGIC=860402
POLL_INTERVAL=1.0

# ── Gestion du risque (1 % de l'équité par trade par défaut) ───────────────
RISK_PERCENT=1.0
MAX_DAILY_DRAWDOWN_PCT=3.0
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0
MAX_LOTS=10.0
MAX_OPEN_POSITIONS=1
COOLDOWN_BARS=2
BREAKEVEN_ENABLED=1
BREAKEVEN_TRIGGER_ATR=1.0
BREAKEVEN_LOCK_ATR=0.2

# ── Indicateurs ─────────────────────────────────────────────────────────────
RSI_PERIOD=14
BB_PERIOD=20
BB_DEV=2.0
EMA_H1_PERIOD=200
ATR_PERIOD=14

# ── Filtre de volatilité ────────────────────────────────────────────────────
MIN_ATR=0.10
MIN_ATR_RATIO=0.0002
MAX_SPREAD=0.50

# ── Filtre horaire (UTC) ────────────────────────────────────────────────────
TIME_FILTER_ENABLED=1
TRADING_START_HOUR=7
TRADING_END_HOUR=21

# ── Filtre de news (ForexFactory) ───────────────────────────────────────────
NEWS_FILTER_ENABLED=1
NEWS_IMPACT=High
NEWS_CURRENCIES=USD,EUR
NEWS_BLOCK_BEFORE_MIN=30
NEWS_BLOCK_AFTER_MIN=30
NEWS_FAIL_CLOSED=0

# ── Variables de déploiement ────────────────────────────────────────────────
PORT=8000
DASHBOARD_PASSWORD=
